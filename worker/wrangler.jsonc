// Cloudflare Workers configuration.
// One Worker serves both the API (/api/*) and the built React frontend
// (everything else, with SPA fallback).
//
// Before the first deploy:
//   1. wrangler d1 create obelix            -> paste database_id below
//   2. wrangler r2 bucket create obelix-documents
//   3. wrangler secret put JWT_SECRET
//   4. npm run migrate:remote
//   5. build the frontend (cd ../frontend && yarn build), then: npm run deploy
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "obelix",
  "main": "src/index.ts",
  "compatibility_date": "2025-06-01",
  "assets": {
    "directory": "../frontend/build",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application",
    "run_worker_first": ["/api", "/api/*"]
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "obelix",
      "database_id": "REPLACE_WITH_YOUR_D1_DATABASE_ID",
      "migrations_dir": "migrations"
    }
  ],
  "r2_buckets": [
    {
      "binding": "DOCS",
      "bucket_name": "obelix-documents"
    }
  ],
  "vars": {
    // Comma-separated list of allowed origins, or * to allow any.
    // Irrelevant for the normal single-Worker deploy (same origin).
    "CORS_ORIGINS": "*"
  },
  "observability": {
    "enabled": true
  }
}
